#pragma once

/* 构建期密钥模板（可选）。对应 MimiClaw 的 mimi_secrets.h。
 * 复制为 src/secrets.h 并填入真实值；运行时的环境变量优先级更高。
 *
 *   cp src/secrets.h.example src/secrets.h
 *
 * 环境变量（运行时覆盖，见 main.c）：
 *   MIMI_API_KEY      Anthropic API key（必填）
 *   MIMI_MODEL        模型名，默认 claude-sonnet-4-5
 *   MIMI_LLM_URL      API 地址，默认 https://api.anthropic.com/v1/messages
 *   MIMI_SEARCH_KEY   Brave Search API key（web_search 工具用，可选）
 *   MIMI_DATA_DIR     数据目录，默认 ~/.mimiclaw
 *   MIMI_TRACE        非空时把 trace 事件写入该文件
 */

/* 如果要使用构建期默认值，取消注释并填写：
#define MIMI_SECRET_API_KEY      "sk-ant-xxxx"
#define MIMI_SECRET_MODEL        "claude-sonnet-4-5"
#define MIMI_SECRET_SEARCH_KEY   ""
*/
